{
  "name": "winzip-jp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "tauri": "tauri",
    "build:debug": "tauri build --debug --bundles app",
    "build:sandbox-e2e": "bash ./scripts/sandbox-e2e.sh",
    "build:appstore": "bash ./scripts/appstore-pkg.sh",
    "test": "tsx --test src/replacements.test.ts src/store.test.ts src/api.test.ts src/guide.test.ts src/compatSkip.test.ts src/e2e/scenes.test.ts",
    "e2e": "node e2e/run.mjs",
    "e2e:tauri": "wdio run e2e/wdio.tauri.conf.ts",
    "store-screenshots": "node e2e/store-screenshots.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10.0.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-service": "^1.1.0",
    "@wdio/types": "^9.32.0",
    "expect-webdriverio": "^6.0.9",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
